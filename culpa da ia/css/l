
#alvo:hover {
transform: scale(1.03);
border-color: #222dc5;
box-shadow: inset 0 0 20px rgba(0, 0, 0, 0.5),
0 10px 30px rgba(34, 197, 94, 0.2);
}

.botoes button {
background: rgba(255, 255, 255, 0.08);
color: #f1f5f9;
border: 1px solid rgba(255, 255, 255, 0.15);
padding: 10px 18px;
border-radius: 8px;
font-size: 0.95rem;
font-weight: 600;
cursor: pointer;

.botoes button:hover {
background: #226ec5;
color: #04120a;
border-color: #2269c5;
transform: translateY(-3px);
box-shadow: 0 6px 15px rgba(21, 40, 207, 0.35);
}

.central {
background: rgba(255, 255, 255, 0.05);
backdrop-filter: blur(12px);
-webkit-backdrop-filter: blur(12px);
border: 1px solid rgba(255, 255, 255, 0.15);
border-radius: 20px;
padding: 30px;
max-width: 500px;
width: 100%;
display: flex;
flex-direction: column;
align-items: center;
gap: 24px;
box-shadow: 0 20px 50px rgba(0, 0, 0, 0.6);
}

